{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal Sift permissions",
  "windows": [
    "main",
    "compose-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "window-state:default",
    "deep-link:default",
    "dialog:default",
    "log:default"
  ]
}
