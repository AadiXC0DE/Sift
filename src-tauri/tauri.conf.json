{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "1.0.0",
  "identifier": "com.aadixc0de.sift",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "pnpm dev:vite", "beforeBuildCommand": "pnpm build" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: sift-att:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' about: data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["default"]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "public.app-category.productivity",
    "macOS": { "minimumSystemVersion": "13.0", "entitlements": null },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": { "active": true, "endpoints": ["https://github.com/AadiXC0DE/Sift/releases/latest/download/latest.json"], "dialog": false, "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IHJlcGxhY2Ugd2l0aCByZWFsIHVwZGF0ZXIgcHVibGljIGtleQ==" },
    "deep-link": { "desktop": { "schemes": ["com.aadixc0de.sift", "mailto"] } }
  }
}
