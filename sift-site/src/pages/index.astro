---
const version = "v1.0.0";
const size = "9.8 MB";
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta property="og:image" content="/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <title>Sift — Email that keeps up with you</title>
  <meta name="description" content="A fast, keyboard-first Gmail client for Mac. Every action under 100 ms." />
</head>
<body>
  <nav style="height:56px;display:flex;align-items:center;gap:16px;padding:0 20px;border-bottom:1px solid #eee;position:sticky;top:0;backdrop-filter:blur(8px)">
    <strong>Sift</strong>
    <a href="/benchmarks">Benchmarks</a>
    <a href="/changelog">Changelog</a>
    <span style="flex:1"></span>
    <a id="download-nav" href="/download">Download for Mac</a>
  </nav>
  <main style="max-width:960px;margin:0 auto;padding:48px 20px">
    <h1>Email that keeps up with you.</h1>
    <p>A fast, keyboard-first Gmail client for Mac. Every action under 100 ms.</p>
    <p><a id="download-hero" href="https://github.com/ownpath/sift/releases/download/v1.0.0/Sift_1.0.0_universal.dmg">Download for macOS</a></p>
    <p><small>{version} · {size} · macOS 13+</small></p>
    <p><a href="/benchmarks">See the benchmarks →</a></p>
    <section id="speed-strip">
      <div>Cold start 0.31 s <small>vs Apple Mail 1.9 s</small></div>
      <div>Open a thread 14 ms</div>
      <div>Archive 22 ms</div>
    </section>
    <section id="feel-it">
      <h2>Feel it</h2>
      <video src="/clips/jk.webm" muted playsinline></video>
      <video src="/clips/archive.webm" muted playsinline></video>
      <video src="/clips/palette.webm" muted playsinline></video>
    </section>
    <section>
      <h2>Make it yours</h2>
      <div id="accent-island">
        <button data-accent="blue">Blue</button>
        <button data-accent="violet">Violet</button>
      </div>
    </section>
    <section><a href="/shortcuts">Shortcuts</a> · <a href="/privacy">Privacy</a> · <a href="/faq">FAQ</a></section>
  </main>
  <footer>Made by ownpath · macOS only for now</footer>
  <script>
    const mac = /Mac/.test(navigator.platform || navigator.userAgent);
    for (const id of ['download-hero', 'download-nav']) {
      const el = document.getElementById(id);
      if (el && !mac) { el.textContent = 'macOS only for now'; el.href = '/download'; }
    }
  </script>
</body>
</html>
