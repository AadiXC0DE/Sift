---
import '../styles/global.css';
import { RELEASES_PAGE, releaseState, releaseView } from '../lib/release';
const release = releaseView(await releaseState(), 'macOS 13 or newer');
const origin = new URL("https://usesift.xyz");
const canonical = new URL("/", origin).href;
const ogImage = new URL("/og.png", origin).href;
const description =
  "Sift is a keyboard-first Gmail client for macOS. A Rust core and a local SQLite mirror keep reading, search and triage on your own machine.";
const appleLogo = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" width="15" height="15" aria-hidden="true" focusable="false"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>`;
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sift",
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "Email client",
  operatingSystem: "macOS 13+",
  description,
  url: canonical,
  inLanguage: "en",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Aaditya", url: "https://github.com/AadiXC0DE" },
  // Version, download URL and file size are only stated when a published
  // release API response backs them; see src/lib/release.ts.
  ...(release.published && release.version && release.size
    ? {
        softwareVersion: release.version.replace(/^v/, ""),
        downloadUrl: release.href,
        fileSize: release.size,
      }
    : {}),
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Sift" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content="Sift · Fast, quiet Gmail for macOS" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sift, a fast keyboard-first Gmail client for macOS" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Sift · Fast, quiet Gmail for macOS" />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#f7f7f8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
  <link rel="icon" type="image/png" href="/favicon-32.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <title>Sift · Fast, quiet Gmail for macOS</title>
  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <script is:inline>
    try {
      const t = localStorage.getItem('sift-theme');
      if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
    } catch { /* private mode: follow the system */ }
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="nav" id="nav">
    <div class="nav-inner">
      <a class="brand" href="/"><img src="/logo.png" alt="Sift" width="23" height="23" />Sift</a>
      <nav class="nav-links" aria-label="Site">
        <a href="/benchmarks">Benchmarks</a>
        <a href="/changelog">Changelog</a>
        <a href="/shortcuts">Shortcuts</a>
        <a href="https://github.com/AadiXC0DE/Sift">GitHub</a>
      </nav>
      <span class="nav-spacer"></span>
      <button class="icon-btn" id="theme-toggle" title="Toggle theme" aria-label="Toggle theme">◐</button>
      <a class="btn btn-primary btn-sm" id="download-nav" href={release.href}><span set:html={appleLogo} />{release.label}</a>
    </div>
  </header>

  <main id="main">
  <div class="hero-stage">
    <section class="hero">
      <div>
        <p class="eyebrow rise">macOS 13+ · Gmail · Rust core{release.size && <> · {release.size}</>}</p>
        <h1 class="rise rise-1">Email that keeps up <span class="thin">with you.</span></h1>
        <p class="sub rise rise-2">A keyboard-first Gmail client for Mac. Your mail is mirrored to your own machine, for quick search and a calmer inbox.</p>
        <div class="hero-ctas rise rise-2">
          <a class="btn btn-primary" id="download-hero" href={release.href}><span set:html={appleLogo} />{release.label}</a>
          <a class="btn btn-secondary" href="#features">Explore Sift</a>
        </div>
        <p class="install-note rise rise-3">No Apple stamp yet. <a href="/download#first-launch">One tiny macOS detour →</a> · <a href="/download#homebrew">Install with Homebrew</a></p>
        <p class="hero-spec rise rise-3">
          {release.size && <><span>{release.size} download</span><span class="sep"></span></>}
          <span>no bundled browser</span><span class="sep"></span><span>mail stays on your Mac</span><span class="sep"></span><span>macOS 13+</span>
        </p>
      </div>
      <div class="preview rise rise-2" id="preview" data-density="comfortable" tabindex="0" aria-label="Sift inbox preview. Focus and press j or k to move.">
        <div class="preview-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="preview-title">Sift · Inbox</span>
          <span class="preview-kbd-hint"><kbd>j</kbd><kbd>k</kbd> to move</span>
        </div>
        <div class="preview-body">
          <div class="preview-side">
            <span class="preview-label active">Inbox <span class="count">3</span></span>
            <span class="preview-label">Starred</span>
            <span class="preview-label">Snoozed <span class="count">2</span></span>
            <span class="preview-label">Sent</span>
            <span class="preview-label">Drafts <span class="count">1</span></span>
          </div>
          <div class="preview-list" id="preview-list">
            <div class="thread unread open">
              <span class="stripe" style="background:#2f6df6"></span>
              <div class="thread-top"><span class="thread-from">Figma</span><span class="star">★</span><span class="thread-time">09:41</span></div>
              <div class="thread-subject">Your prototype got 12 new comments</div>
              <div class="thread-snippet">Maya and 3 others left feedback on Checkout v4…</div>
            </div>
            <div class="thread unread">
              <span class="stripe" style="background:#d6456d"></span>
              <div class="thread-top"><span class="thread-from">Ada Lovelace</span><span class="thread-time">08:17</span></div>
              <div class="thread-subject">Re: launch checklist</div>
              <div class="thread-snippet">Two items left. I took the release notes…</div>
            </div>
            <div class="thread unread">
              <span class="stripe" style="background:#2f6df6"></span>
              <div class="thread-top"><span class="thread-from">GitHub</span><span class="thread-time">07:52</span></div>
              <div class="thread-subject">[sift] CI passed on main</div>
              <div class="thread-snippet">All 34 e2e green. Ready to merge…</div>
            </div>
            <div class="thread">
              <span class="stripe" style="background:#1f9a94"></span>
              <div class="thread-top"><span class="thread-from">Airline</span><span class="thread-time">Tue</span></div>
              <div class="thread-subject">Your trip to Berlin is confirmed</div>
              <div class="thread-snippet">Booking ref KX-2214 · departs Fri 18:40…</div>
            </div>
            <div class="thread">
              <span class="stripe" style="background:#1f9a94"></span>
              <div class="thread-top"><span class="thread-from">Bank</span><span class="thread-time">Mon</span></div>
              <div class="thread-subject">Monthly statement is ready</div>
              <div class="thread-snippet">View it any time in the documents tab…</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="section" aria-label="Footprint" id="footprint">
    <h2>Tiny by design.</h2>
    <p class="lede">A lightweight Mac app that keeps your inbox close. Fast local search, familiar shortcuts, and no bundled browser engine.</p>
    <div class="product-facts">
      <div><span class="product-fact">{release.size ?? 'Built for Mac'}</span><p>{release.size ? 'One download for Apple Silicon and Intel.' : 'Apple Silicon and Intel. macOS 13 or newer.'}</p></div>
      <div><span class="product-fact">Your mail, on your Mac</span><p>Search locally. Read cached messages even when you’re offline.</p></div>
      <div><span class="product-fact">No Sift server</span><p>Connect directly to Gmail. Your credentials stay in the Keychain.</p></div>
    </div>
    <p class="metric-foot"><a href="/benchmarks">See the measurements and build budgets →</a></p>
  </section>

  <section class="section" aria-label="Feel it">
    <h2>Your hands never leave the keys.</h2>
    <p class="lede">Every action has a key. The palette does the rest. Hover a card, or just press the keys.</p>
    <div class="feel">
      <div class="feel-card"><div class="feel-keys"><kbd>j</kbd><kbd>k</kbd></div><p>Glide through the list. No scrolling to think about.</p></div>
      <div class="feel-card"><div class="feel-keys"><kbd>e</kbd></div><p>Archive, and undo it if you blinked.</p></div>
      <div class="feel-card"><div class="feel-keys"><kbd>⌘</kbd><kbd>K</kbd></div><p>Jump anywhere: threads, labels, actions, accounts.</p></div>
      <div class="feel-card"><div class="feel-keys"><kbd>r</kbd></div><p>Reply from the thread. Send-and-archive in one go.</p></div>
    </div>
  </section>

  <section class="section" aria-label="Features" id="features">
    <h2>Built for the way inboxes actually work.</h2>
    <p class="lede">One window for everything. Fast enough that triage stops feeling like work.</p>
    <div class="bento">
      <div class="cell cell-3">
        <h3>Keyboard-first</h3>
        <p>Every action has a key. The palette covers the rest.</p>
        <div class="mini"><span class="row"><span class="k">j / k</span> move</span><span class="row"><span class="k">e / #</span> archive / trash</span><span class="row"><span class="k">⌘K</span> everything else</span></div>
      </div>
      <div class="cell cell-3">
        <h3>All your inboxes</h3>
        <p>Personal, work, clients. Unified, color-coded, one shortcut apart.</p>
        <div class="chips"><span class="chip">you@gmail · blue</span><span class="chip">you@work · rose</span><span class="chip">studio · teal</span></div>
        <div class="mini"><span class="row"><span class="k">⌘1 / ⌘2</span> switch account</span><span class="row"><span class="k">⌘0</span> unified inbox</span></div>
      </div>
      <div class="cell cell-2">
        <h3>Mistakes are cheap</h3>
        <p>Snooze, undo, undo send.</p>
        <div class="mini"><span class="row">Archived · Undo</span></div>
      </div>
      <div class="cell cell-2">
        <h3>Ready when you’re offline</h3>
        <p>Search your local mailbox and read messages you’ve already opened.</p>
        <div class="mini"><span class="row">cached messages · on this Mac</span></div>
      </div>
      <div class="cell cell-2">
        <h3>Private by design</h3>
        <p>Tokens live in the macOS Keychain. There is no Sift server.</p>
        <div class="mini"><span class="row">Keychain · no trackers · local-first</span></div>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Make it yours">
    <h2>Make it yours.</h2>
    <p class="lede">Theme, accent, density. This page and the preview above follow along. Try it.</p>
    <div class="island">
      <div class="island-group" role="group" aria-label="Accent">
        <button class="swatch" data-accent="blue" aria-pressed="true" aria-label="Blue accent"></button>
        <button class="swatch" data-accent="indigo" aria-pressed="false" aria-label="Indigo accent"></button>
        <button class="swatch" data-accent="violet" aria-pressed="false" aria-label="Violet accent"></button>
        <button class="swatch" data-accent="rose" aria-pressed="false" aria-label="Rose accent"></button>
        <button class="swatch" data-accent="orange" aria-pressed="false" aria-label="Orange accent"></button>
        <button class="swatch" data-accent="green" aria-pressed="false" aria-label="Green accent"></button>
        <button class="swatch" data-accent="teal" aria-pressed="false" aria-label="Teal accent"></button>
        <button class="swatch" data-accent="graphite" aria-pressed="false" aria-label="Graphite accent"></button>
      </div>
      <div class="seg" role="group" aria-label="Density">
        <button data-density="comfortable" aria-pressed="true">Roomy</button>
        <button data-density="compact" aria-pressed="false">Compact</button>
      </div>
      <span class="island-label">The app's real accents. Live on this page.</span>
    </div>
  </section>

  <section class="section" aria-label="Architecture">
    <h2>A small app. A solid foundation.</h2>
    <p class="lede">A Rust core does the heavy lifting once, then every read hits a local SQLite file. Mail goes directly between your Mac and Google.</p>
    <div class="flow">
      <div class="flow-node"><span class="flow-k">Gmail</span><span class="flow-d">IMAP or REST, over TLS</span></div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="flow-node flow-core"><span class="flow-k">Rust core</span><span class="flow-d">sync · MIME · sanitize · FTS</span></div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="flow-node"><span class="flow-k">SQLite mirror</span><span class="flow-d">WAL · FTS5 · on your Mac</span></div>
      <span class="flow-arrow" aria-hidden="true">→</span>
      <div class="flow-node"><span class="flow-k">Your screen</span><span class="flow-d">local lists and search</span></div>
    </div>
    <p class="rust-cta">The source is public. <a href="https://github.com/AadiXC0DE/Sift">Read the code</a> · <a href="/benchmarks">see what is measured</a></p>
  </section>

  <section class="section" aria-label="Connect">
    <h2>Connected in a few steps.</h2>
    <ol class="steps">
      <li><span class="step-n">1</span><p>Turn on 2-Step Verification (<a href="https://myaccount.google.com/signinoptions/two-step-verification">open settings</a>).</p></li>
      <li><span class="step-n">2</span><p>Create an app password named Sift (<a href="https://myaccount.google.com/apppasswords">open App passwords</a>).</p></li>
      <li><span class="step-n">3</span><p>Paste the 16 letter password in Sift and press Connect.</p></li>
    </ol>
  </section>

  <section class="cta" aria-label="Download">
    <div class="cta-box">
      <h2>Clear your inbox today.</h2>
      <p class="sub">Free while in beta. {release.published ? `${release.version} · ${release.size} · macOS 13 or newer.` : 'macOS 13 or newer.'}</p>
      {!release.published && <p class="metric-foot">{release.status}</p>}
      <div class="cta-row">
        <a class="btn btn-primary" id="download-cta" href={release.href}><span set:html={appleLogo} />{release.label}</a>
        <a class="btn btn-secondary" href="/download">Installation guide</a>
      </div>
      <p class="install-note">Unnotarized beta. <a href="/download#first-launch">First-launch steps, including when “Open Anyway” is missing →</a></p>
      <details class="sha">
        <summary>Checksums and release notes</summary>
        {
          release.sha ? (
            <p>
              SHA-256 of the DMG published in {release.version}: <code>{release.sha}</code> — read from that
              release's <code>SHA256SUMS</code> asset rather than typed by hand. Every release ships sums next
              to the DMG on <a href={RELEASES_PAGE}>GitHub</a>.
            </p>
          ) : (
            <p>
              Every release ships SHA-256 sums next to the DMG on <a href={RELEASES_PAGE}>GitHub</a>, generated
              from the exact bytes the pipeline uploads. {release.status}
            </p>
          )
        }
      </details>
    </div>
  </section>

  </main>
  <footer class="site">
    <div class="footer-inner">
      <nav aria-label="Footer">
        <a href="/shortcuts">Shortcuts</a>
        <a href="/privacy">Privacy</a>
        <a href="/faq">FAQ</a>
        <a href="/benchmarks">Benchmarks</a>
        <a href="https://github.com/AadiXC0DE/Sift">GitHub</a>
      </nav>
      <span class="footer-right">Made by <a href="https://github.com/AadiXC0DE">Aaditya</a></span>
    </div>
  </footer>

  <script>
    // Sticky nav border after 8px scroll.
    const nav = document.getElementById('nav');
    const onScroll = () => nav && nav.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    // Theme toggle: explicit light/dark, stored; unset follows the system.
    const toggle = document.getElementById('theme-toggle');
    const applyIcon = () => {
      if (!toggle) return;
      const t = document.documentElement.dataset.theme;
      toggle.textContent = t === 'dark' ? '◑' : t === 'light' ? '◐' : '◐';
      toggle.setAttribute('aria-label', t ? `Theme: ${t}. Switch to ${t === 'dark' ? 'light' : 'dark'}` : 'Theme: system. Switch to dark');
    };
    applyIcon();
    toggle && toggle.addEventListener('click', () => {
      const cur = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const next = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('sift-theme', next); } catch { /* ignore */ }
      applyIcon();
    });
    // Accent + density island: recolors this page and the hero preview live.
    const root = document.documentElement;
    const preview = document.getElementById('preview');
    document.querySelectorAll('.swatch').forEach((b) => {
      b.addEventListener('click', () => {
        root.dataset.accent = b.dataset.accent || 'blue';
        document.querySelectorAll('.swatch').forEach((o) => o.setAttribute('aria-pressed', o === b ? 'true' : 'false'));
      });
    });
    document.querySelectorAll('.seg button').forEach((b) => {
      b.addEventListener('click', () => {
        if (preview) preview.dataset.density = b.dataset.density || 'comfortable';
        document.querySelectorAll('.seg button').forEach((o) => o.setAttribute('aria-pressed', o === b ? 'true' : 'false'));
      });
    });
    // Hero preview: j/k moves, click selects. Scoped to the preview element.
    const rows = Array.from(document.querySelectorAll('#preview-list .thread'));
    const select = (i) => {
      rows.forEach((r, j) => r.classList.toggle('open', i === j));
    };
    let idx = 0;
    rows.forEach((r, j) => r.addEventListener('click', () => { idx = j; select(idx); }));
    preview && preview.addEventListener('keydown', (e) => {
      if (e.key !== 'j' && e.key !== 'k') return;
      e.preventDefault();
      idx = (idx + (e.key === 'j' ? 1 : -1) + rows.length) % rows.length;
      select(idx);
    });
  </script>
<script>
    import { initMotion } from '../lib/motion';
    initMotion();
  </script>
</body>
</html>
