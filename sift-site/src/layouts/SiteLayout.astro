---
import '../styles/global.css';
import { releaseState, releaseView } from '../lib/release';
interface Props {
  title: string;
  description?: string;
  path?: string;
}
const {
  title,
  description = 'Fast, quiet email for Gmail on macOS. Native Rust core, local-first, keyboard-first.',
  path = '',
} = Astro.props;
const nav = [
  { href: '/benchmarks', label: 'Benchmarks' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/shortcuts', label: 'Shortcuts' },
  { href: '/faq', label: 'FAQ' },
];
const release = releaseView(await releaseState(), 'macOS 13 or newer');
const appleLogo = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" width="15" height="15" aria-hidden="true" focusable="false"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>`;
const origin = Astro.site ?? new URL('https://usesift.xyz');
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/og.png', origin).href;
const siteName = 'Sift';
const fullTitle = path === '/' || title === 'Sift' ? `${title} · Fast, quiet Gmail for macOS` : `${title} · Sift`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: origin.href,
  description,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: origin.href,
    logo: new URL('/logo.png', origin).href,
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sift, a fast keyboard-first Gmail client for macOS" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1b1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      try {
        const t = localStorage.getItem('sift-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
  <a class="skip-link" href="#main">Skip to content</a>
    <header class="nav" id="nav">
      <div class="nav-inner">
        <a class="brand" href="/"><img src="/logo.png" alt="Sift" width="23" height="23" />Sift</a>
        <nav class="nav-links" aria-label="Site">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <a href="https://github.com/AadiXC0DE/Sift">GitHub</a>
        </nav>
        <span class="nav-spacer"></span>
        <button class="icon-btn" id="theme-toggle" title="Toggle theme" aria-label="Toggle theme">◐</button>
        <a class="btn btn-primary btn-sm" href={release.href}><span set:html={appleLogo} />{release.label}</a>
      </div>
    </header>

    <main class="page" id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="footer-inner">
        <nav aria-label="Footer">
          <a href="/shortcuts">Shortcuts</a>
          <a href="/privacy">Privacy</a>
          <a href="/faq">FAQ</a>
          <a href="/benchmarks">Benchmarks</a>
          <a href="https://github.com/AadiXC0DE/Sift">GitHub</a>
        </nav>
        <span class="footer-right">Made by <a href="https://github.com/AadiXC0DE">Aaditya</a></span>
      </div>
    </footer>

    <script is:inline>
      const navEl = document.getElementById('nav');
      const onScroll = () => navEl && navEl.classList.toggle('scrolled', window.scrollY > 8);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      const toggle = document.getElementById('theme-toggle');
      const applyIcon = () => {
        if (!toggle) return;
        const t = document.documentElement.dataset.theme;
        toggle.textContent = t === 'dark' ? '◑' : '◐';
        toggle.setAttribute(
          'aria-label',
          t ? `Theme: ${t}. Switch to ${t === 'dark' ? 'light' : 'dark'}` : 'Theme: system. Switch to dark',
        );
      };
      applyIcon();
      toggle &&
        toggle.addEventListener('click', () => {
          const cur = document.documentElement.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('sift-theme', next);
          } catch {}
          applyIcon();
        });
    </script>
  <script>
    import { initMotion } from '../lib/motion';
    initMotion();
  </script>
</body>
</html>
