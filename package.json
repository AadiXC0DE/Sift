{
  "name": "sift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "productName": "Sift",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "build:tauri": "tauri build",
    "preview": "vite preview",
    "lint": "eslint src e2e --max-warnings 0 && tsc --noEmit && prettier --check src e2e && tsx scripts/check-dto-sync.ts && tsx scripts/check-colors.ts",
    "lint:fix": "eslint src e2e --fix && prettier --write src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
